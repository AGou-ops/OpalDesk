<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.BLUETOOTH" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="OpalDesk"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <property
            android:name="android.window.PROPERTY_SUPPORTS_MULTI_INSTANCE_SYSTEM_UI"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="OpalDesk"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.lengsukq.opaldesk.tablet"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|touchscreen|colorMode|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".LocalDexActivity"
            android:exported="true"
            android:label="OpalDesk 本机 DeX"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.lengsukq.opaldesk.localdex"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustNothing|stateHidden"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|touchscreen|colorMode|density|uiMode" />

        <activity
            android:name=".TouchpadActivity"
            android:exported="false"
            android:label="OpalDesk 触摸板"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.lengsukq.opaldesk.tablet"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|touchscreen|colorMode|density|uiMode" />

        <activity
            android:name=".SideControlActivity"
            android:exported="false"
            android:label="OpalDesk 副屏直控"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.lengsukq.opaldesk.tablet"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|touchscreen|colorMode|density|uiMode" />

        <activity
            android:name=".SideMouseCaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:resizeableActivity="false"
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen"
            android:taskAffinity="io.github.lengsukq.opaldesk.capture"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:label="OpalDesk 桌面"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.lengsukq.opaldesk.extdesktop"
            android:resizeableActivity="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|touchscreen|colorMode|density|uiMode" />

        <service
            android:name=".BridgeService"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="External display overlay controller and cursor presenter" />
        </service>

        <service
            android:name=".NavAssistService"
            android:exported="true"
            android:label="OpalDesk 平板辅助手势"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/nav_assist_config" />
        </service>

        <receiver
            android:name=".ControlReceiver"
            android:exported="true"
            android:permission="android.permission.INJECT_EVENTS">
            <intent-filter>
                <action android:name="io.github.lengsukq.opaldesk.BINDER_PUSH" />
                <action android:name="io.github.lengsukq.opaldesk.TOGGLE_INPUT" />
                <action android:name="io.github.lengsukq.opaldesk.STATE_SYNC" />
                <action android:name="io.github.lengsukq.opaldesk.REBUILD" />
                <action android:name="io.github.lengsukq.opaldesk.LAUNCH_EXT_HOME" />
                <action android:name="io.github.lengsukq.opaldesk.TOGGLE_MIRROR" />
                <action android:name="io.github.lengsukq.opaldesk.SET_MIRROR_SIDE_MODE" />
                <action android:name="io.github.lengsukq.opaldesk.SPLIT_ACTION" />
                <action android:name="io.github.lengsukq.opaldesk.SET_ROTATION" />
                <action android:name="io.github.lengsukq.opaldesk.SET_DOCK_AUTO_HIDE" />
                <action android:name="io.github.lengsukq.opaldesk.STOP_LOCAL_DEX" />
                <action android:name="io.github.lengsukq.opaldesk.EXIT_ALL" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ControlReceiver$Internal"
            android:exported="false" />

        <receiver
            android:name=".AdbPairingReceiver"
            android:exported="false" />

        <provider
            android:name=".BridgeProvider"
            android:authorities="io.github.lengsukq.opaldesk.provider"
            android:exported="true" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
